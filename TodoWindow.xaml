<Window x:Class="Progra_JauresWilson.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Progra_JauresWilson"
        Title="To-Do List" Height="450" Width="500"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Instance du convertisseur d'affichage -->
        <local:Convertisseur_Task x:Key="TaskStatusConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Zone d'ajout de tâche -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtNewTask" Grid.Column="0" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Ajouter" Grid.Column="1" Width="80" Height="30" Click="BtnAdd_Click"/>
        </Grid>

        <!-- Liste des tâches -->
        <ListBox x:Name="lstTasks" Grid.Row="1" Margin="0,0,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                 Foreground="{Binding IsDone, Converter={StaticResource TaskStatusConverter}}"
                                 TextDecorations="{Binding IsDone, Converter={StaticResource TaskStatusConverter}}"
                                 BorderThickness="0" Background="Transparent" VerticalAlignment="Center" MinWidth="250"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Boutons d'action -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Supprimer" Width="100" Height="30" Margin="0,0,10,0" Click="BtnDelete_Click"/>
            <Button Content="Enregistrer" Width="100" Height="30" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>