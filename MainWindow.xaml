<Window x:Class="Progra_JauresWilson.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="20">
        <!-- Définition des 3 colonnes : Bouton | Séparateur | Formulaire -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Content="&lt; Retour au menu" Height="35" Width="140" 
                VerticalAlignment="Top" Margin="0,0,15,0" 
                Click="BtnBack_Click" Background="#555555" Foreground="White" 
                FontWeight="Bold" BorderThickness="0"/>

        <!-- 2. Barre de séparation verticale -->
        <Rectangle Grid.Column="1" Width="1" Fill="#CCCCCC" Margin="0,0,20,0" VerticalAlignment="Stretch"/>

        <!-- 3. Formulaire d'envoi d'e-mail à droite -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <TextBlock Text="Formulaire d'envoi d'e-mail" FontSize="20" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,15"/>

            <!-- Expéditeur -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Expéditeur  :" FontWeight="Bold" Foreground="#333333"/>
                <TextBox x:Name="txtFrom" Text="Votreadresse@email.com" Padding="6" Margin="0,5,0,0" Background="#FFFFFF" BorderBrush="#CCCCCC"/>
            </StackPanel>

            <!-- Destinataire -->
            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Destinataire :" FontWeight="Bold" Foreground="#333333"/>
                <TextBox x:Name="txtTo" Text="tatebongjaures@gmail.com" Padding="6" Margin="0,5,0,0" Background="#FFFFFF" BorderBrush="#CCCCCC"/>
            </StackPanel>

            <!-- Objet / Sujet -->
            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="Sujet :" FontWeight="Bold" Foreground="#333333"/>
                <TextBox x:Name="txtSubject" Padding="6" Margin="0,5,0,0" Background="#FFFFFF" BorderBrush="#CCCCCC"/>
            </StackPanel>

            <!-- Message -->
            <Grid Grid.Row="4" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Message :" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,5"/>
                <TextBox x:Name="txtBody" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto" Padding="6" Background="#FFFFFF" BorderBrush="#CCCCCC"/>
            </Grid>

            <!-- Bouton Envoyer -->
            <Button Grid.Row="5" Content="Envoyer le message" Height="38" 
                    Click="BtnSend_Click" Background="#007ACC" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>