<Window x:Class="Progra_JauresWilson.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Bouton Retour à gauche -->
        <Button x:Name="BtnBack" Content="&lt; Retour au menu" 
                Width="140" Height="40" 
                HorizontalAlignment="Left" VerticalAlignment="Top" 
                Background="#555555" Foreground="White" FontWeight="Bold"
                Click="BtnBack_Click"/>

        <!-- Formulaire à droite -->
        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock Text="Formulaire d'envoi d'e-mail" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Expéditeur -->
            <TextBlock Text="Votre adresse e-mail :" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtFrom" Height="30" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

            <!-- Champ Mot de passe ajouté ici -->
            <TextBlock Text="Mot de passe :" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="30" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

            <!-- Destinataire -->
            <TextBlock Text="Destinataire :" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtTo" Height="30" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

            <!-- Sujet -->
            <TextBlock Text="Sujet :" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtSubject" Height="30" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

            <!-- Message -->
            <TextBlock Text="Message :" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtBody" Height="150" TextWrapping="Wrap" AcceptsReturn="True" 
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>

            <!-- Bouton Envoyer -->
            <Button x:Name="BtnSend" Content="Envoyer le message" Height="40" 
                    Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="14"
                    Click="BtnSend_Click"/>
        </StackPanel>
    </Grid>
</Window>