<Window x:Class="Progra_JauresWilson.ChronoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Progra_JauresWilson"
        Title="Chronomètre Analogique" Height="480" Width="420"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:ChronoViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Text="Chronomètre Analogique" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Cadran Analogique -->
        <Grid Grid.Row="1" Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Cercle Extérieur du cadran -->
            <Ellipse Stroke="Black" StrokeThickness="4" Fill="#F8F9FA"/>

            <!-- Point Central -->
            <Ellipse Width="12" Height="12" Fill="Red" Panel.ZIndex="2"/>

            <!-- Aiguille des secondes rotative -->
            <Rectangle Width="4" Height="90" Fill="Red" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0" RenderTransformOrigin="0.5,1">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="{Binding SecondsAngle}"/>
                </Rectangle.RenderTransform>
            </Rectangle>

            <!-- Marqueurs horaires / secondes simples -->
            <TextBlock Text="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" FontWeight="Bold"/>
            <TextBlock Text="6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" FontWeight="Bold"/>
            <TextBlock Text="9" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="Bold"/>
            <TextBlock Text="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
        </Grid>

        <!-- Temps Numérique -->
        <TextBlock Grid.Row="2" Text="{Binding TimeDisplay}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15"/>

        <!-- Boutons de Contrôle -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Démarrer" Command="{Binding StartCommand}" Width="90" Height="32" Margin="5"/>
            <Button Content="Arrêter" Command="{Binding StopCommand}" Width="90" Height="32" Margin="5"/>
            <Button Content="Réinitialiser" Command="{Binding ResetCommand}" Width="90" Height="32" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>