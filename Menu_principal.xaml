<Window x:Class="Progra_JauresWilson.Menu_principal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menu Principal" Height="350" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Border Background="#2D2D30">
        <StackPanel Margin="20">
            <TextBlock Text="MENU-WILSON-HUB" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,25" HorizontalAlignment="Center"/>

            <Button Content="Accueil" Height="40" Margin="0,0,0,15" 
                    Click="BtnHome_Click" Background="#3E3E42" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>

            <Button Content="Envoyer un E-mail" Height="40" Margin="0,0,0,15" 
                    Click="BtnEmail_Click" Background="#3E3E42" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>

            <Button x:Name="BtnTodo" Content="To-Do List" Height="40" Margin="0,0,0,10" 
                    Click="BtnTodo_Click" Background="#3E3E42" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </Border>
</Window>