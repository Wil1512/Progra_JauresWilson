<Window x:Class="Progra_JauresWilson.Menu_principal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Progra_JauresWilson"
        mc:Ignorable="d"
        Title="Menu_principal" Height="450" Width="800">
    <Grid>
        <Border Grid.Column="0" Background="#2D2D30">
            <StackPanel Margin="10,20,10,10">
                <TextBlock Text="MENU-HUB" Foreground="White" FontSize="16" FontWeight="Bold" Margin="10,0,0,20"/>

                <Button Content="Accueil" Height="40" Margin="0,0,0,10" 
                        Click="BtnHome_Click" Background="#3E3E42" Foreground="White" BorderThickness="0"/>

                <Button Content="Envoyer un E-mail" Height="40" Margin="0,0,0,10" 
                        Click="BtnEmail_Click" Background="#3E3E42" Foreground="White" BorderThickness="0"/>

                
            </StackPanel>
        </Border>

        
        <ContentControl x:Name="MainContent" Grid.Column="1"/>
    </Grid>
</Window>
